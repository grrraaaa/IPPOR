<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>food</groupId>
    <artifactId>delivery</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Значение по умолчанию (используется обычной сборкой без профиля) -->
        <app.min.order.amount>500</app.min.order.amount>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>

        <!-- Фильтрация ресурсов: ${app.min.order.amount} в application.properties
             заменяется реальным значением из <properties> активного профиля. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!-- Исполняемый JAR: java -jar target/delivery-1.0-SNAPSHOT.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>food.delivery.Application</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
        ИНДИВИДУАЛЬНОЕ ЗАДАНИЕ — ВАРИАНТ 5 (доставка еды).
        Профиль "promo" поднимает минимальную сумму заказа до 1000.
        Тест placeOrder_successful (сумма 550) при таком минимуме ПАДАЕТ:
        обычная сборка зелёная, промо-сборка красная.
        Активация: mvn -P promo package
    -->
    <profiles>
        <profile>
            <id>promo</id>
            <properties>
                <app.min.order.amount>1000</app.min.order.amount>
            </properties>
        </profile>
    </profiles>
</project>
